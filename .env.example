# Copy to .env (server) and client/.env (client) as needed. Every value here is optional.

# ---- server ----
PORT=4000
# 127.0.0.1 in development, 0.0.0.0 in production by default
# HOST=0.0.0.0
# Comma-separated origins allowed to open sockets and call the API (empty = allow any)
# CLIENT_ORIGIN=https://code.example.com

# Where rooms are saved: file (default), sqlite (Node's built-in node:sqlite) or memory
PERSISTENCE=file
# DATA_DIR=./server/data

# Code runner: piston (self-hosted Piston), local (your own machine, NOT a sandbox) or disabled.
# Default: piston when PISTON_URL is set, local in development, disabled in production.
# RUNNER=piston
# PISTON_URL=http://localhost:2000
RUN_TIMEOUT_MS=10000
RUNS_PER_MINUTE=10

# ---- client (Vite reads VITE_* at build time) ----
# Leave empty to use the same origin (the Vite proxy in development, Express in production).
# VITE_SERVER_URL=https://api.example.com
# Dev only: where the Vite proxy forwards /api and /yjs, and the Vite port
# DEV_PROXY_TARGET=http://127.0.0.1:4000
# CLIENT_PORT=5173
